{
  "manifest_version": 3,
  "name": "ERP 采集管理",
  "version": "2.6.3",
  "description": "从阿里国际站、1688 采集产品信息到 Trade ERP，支持图片、属性、变体、阶梯定价的完整采集。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.alibaba.com/*",
    "https://*.1688.com/*",
    "https://serp.cpolar.cn/*",
    "https://derp.cpolar.cn/*",
    "http://localhost:3001/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "采集到 ERP"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.alibaba.com/*",
        "https://*.1688.com/*"
      ],
      "js": [
        "parsers/selector-registry.js",
        "parsers/jsonld-parser.js",
        "parsers/tiered-price-parser.js",
        "parsers/variant-parser.js",
        "parsers/spec-parser.js",
        "parsers/image-processor.js",
        "parsers/payload-assembler.js",
        "parsers/alibaba-v2.js",
        "parsers/attr-patch.js",
        "parsers/bclass-fix.js",
        "parsers/collect-fix.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
